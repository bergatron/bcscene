#!/usr/bin/env python3
"""bcscene — run a Basecamp scene."""

import argparse
import sys
import os

# Allow running from repo root without installing
HERE = os.path.dirname(os.path.abspath(__file__))
sys.path.insert(0, os.path.join(os.path.dirname(HERE), "lib"))

from loader import load_scene
from executor import execute_scene


def main():
    p = argparse.ArgumentParser(description="Run a Basecamp scene.")
    p.add_argument("scene", help="Path to scene YAML file")
    p.add_argument("--dry-run", action="store_true",
                   help="Print commands without running them")
    p.add_argument("--pause", type=float, default=1.0,
                   help="Seconds between steps (default: 1.0)")
    args = p.parse_args()

    scene = load_scene(args.scene)
    execute_scene(scene, dry_run=args.dry_run, pause=args.pause)


if __name__ == "__main__":
    main()
