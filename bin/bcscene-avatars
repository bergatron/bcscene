#!/usr/bin/env python3
"""Generate distinct emoji avatars for every persona in personas.yaml and
upload each one as that persona (self-serve profile update).

Rendering: 256x256 PNG, two-tone vertical gradient + Apple Color Emoji glyph.
Output: avatars/<persona>.png (committed — reusable when re-provisioning).

Upload: PUT /<account>/my/profile.json (multipart, person[avatar]) using the
persona's own OAuth token from `basecamp -P <name> auth token`. Personas
without an authenticated profile are skipped and reported — re-run after more
personas complete OAuth.

Usage:
  bin/bcscene-avatars              # render all + upload where possible
  bin/bcscene-avatars --render-only
  bin/bcscene-avatars --upload-only
  bin/bcscene-avatars --only sandy,patty
"""
import os, sys, subprocess, json

REPO = os.path.dirname(os.path.dirname(os.path.abspath(__file__)))
sys.path.insert(0, os.path.join(REPO, "lib"))
import yaml
from PIL import Image, ImageDraw, ImageFont

EMOJI_FONT = "/System/Library/Fonts/Apple Color Emoji.ttc"
STRIKE = 160  # Apple Color Emoji is bitmap; must use an exact strike size
SIZE = 256

# Illustrated avatars via DiceBear (api.dicebear.com, CC0/CC-BY styles —
# see dicebear.com/licenses; internal QA fixture use). Personas listed here
# get an illustrated person; anyone absent falls back to the emoji style
# below. Format: (dicebear style, seed, background hex sans #).
DICEBEAR = {
    "sandy":    ("open-peeps", "Sandy Shoreman",  "ffe0b2"),
    "patty":    ("lorelei",    "Patty Pagination", "d7e3fc"),
    "vince":    ("open-peeps", "Vince Volume Loud","ffd6d6"),
    "greta":    ("notionists", "Greta Gridline",   "d8f3dc"),
    "alphabet": ("croodles",   "Alphabet Tester",  "e8d5ff"),
    "bart":     ("adventurer", "Bartholomew FC",   "fff0c2"),
    "dmitry":   ("lorelei",    "Dmitry Testov",    "ffe5ec"),
    "haruto":   ("adventurer", "Haruto Sato",      "d0f4f7"),
    "lola":     ("adventurer", "Lola Longfield",   "fde2ff"),
    "max":      ("notionists", "Max Verylong",     "e2f7d5"),
    "mira":     ("lorelei",    "Mira Ikhtibar",    "e0e0f8"),
    "nono":     ("open-peeps", "Nono Muller",      "d5f5e3"),
    "oscar":    ("notionists", "Oscar Overflow",   "f5e0cc"),
    "pedro":    ("croodles",   "Pedro Picapiedra", "e8e8e8"),
    "quinn":    ("croodles",   "Quinn OQuibble",   "ffe9f9"),
    "tina":     ("adventurer", "Tina Tablesaw",    "fff3b0"),
    "ulysses":  ("open-peeps", "Ulysses Underscore", "cce6ff"),
    "wanda":    ("adventurer", "Wanda Maximoff",   "ffe0cc"),
    "yuki":     ("adventurer", "Yuki Tanaka",      "e3f2fd"),
    # "unicorn" deliberately keeps the 🦄 emoji avatar — a mixed roster is
    # more realistic than a uniform one.
}

# emoji + (top color, bottom color) per persona, themed to their character
STYLE = {
    "sandy":    ("🐚", ("#f6d365", "#fda085")),
    "patty":    ("📖", ("#a1c4fd", "#c2e9fb")),
    "vince":    ("📢", ("#f77062", "#fe5196")),
    "greta":    ("📐", ("#84fab0", "#8fd3f4")),
    "alphabet": ("🔡", ("#e0c3fc", "#8ec5fc")),
    "bart":     ("🧇", ("#fddb92", "#d1a054")),
    "dmitry":   ("🪆", ("#ff9a9e", "#fecfef")),
    "haruto":   ("🤖", ("#89f7fe", "#66a6ff")),
    "lola":     ("📚", ("#fbc2eb", "#a6c1ee")),
    "max":      ("📏", ("#96e6a1", "#d4fc79")),
    "mira":     ("🌙", ("#30336b", "#686de0")),
    "nono":     ("🌍", ("#43e97b", "#38f9d7")),
    "oscar":    ("📦", ("#c79081", "#dfa579")),
    "pedro":    ("🪨", ("#8e9eab", "#eef2f3")),
    "quinn":    ("💬", ("#f093fb", "#f5576c")),
    "tina":     ("🎉", ("#fa709a", "#fee140")),
    "ulysses":  ("⛵", ("#4facfe", "#00f2fe")),
    "unicorn":  ("🦄", ("#a18cd1", "#fbc2eb")),
    "wanda":    ("🥞", ("#ffd194", "#d1913c")),
    "yuki":     ("⛄", ("#e6e9f0", "#a1c4fd")),
}
DEFAULT_STYLE = ("🙂", ("#c3cfe2", "#f5f7fa"))

def hex2rgb(h):
    h = h.lstrip("#")
    return tuple(int(h[i:i+2], 16) for i in (0, 2, 4))

def render(name):
    out = os.path.join(REPO, "avatars", f"{name}.png")
    os.makedirs(os.path.dirname(out), exist_ok=True)
    if name in DICEBEAR:
        style, seed, bg = DICEBEAR[name]
        url = (f"https://api.dicebear.com/9.x/{style}/png"
               f"?seed={seed.replace(' ', '%20')}&size={SIZE}&backgroundColor={bg}")
        r = subprocess.run(["curl", "-sS", "-f", url, "-o", out],
                           capture_output=True, text=True)
        if r.returncode == 0:
            return out
        print(f"{name}: dicebear fetch failed ({r.stderr.strip()[:80]}), using emoji fallback")
    return render_emoji(name)

def render_emoji(name):
    emoji, (top, bottom) = STYLE.get(name, DEFAULT_STYLE)
    t, b = hex2rgb(top), hex2rgb(bottom)
    img = Image.new("RGBA", (SIZE, SIZE))
    px = img.load()
    for y in range(SIZE):
        f = y / (SIZE - 1)
        row = tuple(round(t[i] + (b[i] - t[i]) * f) for i in range(3)) + (255,)
        for x in range(SIZE):
            px[x, y] = row
    font = ImageFont.truetype(EMOJI_FONT, STRIKE)
    ImageDraw.Draw(img).text((SIZE // 2, SIZE // 2 + 4), emoji, font=font,
                             embedded_color=True, anchor="mm")
    out = os.path.join(REPO, "avatars", f"{name}.png")
    os.makedirs(os.path.dirname(out), exist_ok=True)
    img.convert("RGB").save(out, "PNG")
    return out

def token_for(name):
    r = subprocess.run(["basecamp", "-P", name, "auth", "token"],
                       capture_output=True, text=True)
    tok = r.stdout.strip().splitlines()[-1].strip() if r.stdout.strip() else ""
    return tok if r.returncode == 0 and len(tok) > 20 else None

def upload(name, path, account):
    tok = token_for(name)
    if not tok:
        return "no-profile"
    r = subprocess.run([
        "curl", "-sS", "-o", "/dev/null", "-w", "%{http_code}",
        "-X", "PUT", f"https://3.basecampapi.com/{account}/my/profile.json",
        "-H", f"Authorization: Bearer {tok}",
        "-F", f"person[avatar]=@{path};type=image/png",
    ], capture_output=True, text=True)
    return "ok" if r.stdout.strip() in ("204", "200") else f"http {r.stdout.strip()}"

def main():
    roster = yaml.safe_load(open(os.path.join(REPO, "personas.yaml")))
    account = str(roster["account_id"])
    names = [p["name"] for p in roster["personas"]]
    if "--only" in sys.argv:
        keep = set(sys.argv[sys.argv.index("--only") + 1].split(","))
        names = [n for n in names if n in keep]
    render_only = "--render-only" in sys.argv
    upload_only = "--upload-only" in sys.argv
    skipped = []
    for n in names:
        path = os.path.join(REPO, "avatars", f"{n}.png")
        if not upload_only:
            path = render(n)
        status = "rendered"
        if not render_only:
            status = upload(n, path, account)
            if status == "no-profile":
                skipped.append(n)
        print(f"{n:10} {status}")
    if skipped:
        print(f"\nno OAuth profile yet (re-run after setup): {', '.join(skipped)}")

if __name__ == "__main__":
    main()
